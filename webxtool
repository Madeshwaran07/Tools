def active_window_time_check(secure_rack_access_tic):
    #query to find DESC(window time from tic)
    query_to_fetch_desc = f"/home/noccsync/nocc/sysops-labs/siebel_query --json -q \"select DESCRIPTION from CMN_INT.AK_ISSUE where ISSUE_ID='{secure_rack_access_tic}'\""
    try:
        desc = subprocess.check_output(query_to_fetch_desc,shell=True, text=True)
        _CC.ClrPrint(f"Calculating window time | Hang on...",'BLK','BLD')
        matches = re.findall(r"\d{2}/\d{2}/\d{4} \d{2}:\d{2} in GMT", desc)
        if matches and len(matches) == 2:
            win_start_time_str = matches[0]
            win_end_time_str = matches[1]
            win_start_time = datetime.strptime(win_start_time_str, "%m/%d/%Y %H:%M in GMT")
            win_end_time = datetime.strptime(win_end_time_str, "%m/%d/%Y %H:%M in GMT")
            current_time = datetime.utcnow()
            time_left_to_access_window = win_end_time - win_start_time
            if time_left_to_access_window < timedelta(hours=24) and win_end_time > win_start_time and current_time > win_start_time:
                print("Access window is less than 24 hours, and the current time is within the window.")
                print(f"Start time: {win_start_time}")
                print(f"End time: {win_end_time}")
                formatted_time = current_time.strftime("%m/%d/%Y %H:%M in GMT")
                print(f"Current date and time: {formatted_time}")
            else:
                print(f"Start time: {win_start_time}")
                print(f"End time: {win_end_time}")
                formatted_time = current_time.strftime("%m/%d/%Y %H:%M in GMT")
                print(f"Current date and time: {formatted_time}")
                print("Window time Conditions are'nt met | NOT SAFE TO WORK")
                sys.exit()
    except subprocess.CalledProcessError as e:
        print(f"Error fetching Description from Ticket | Please check manually")

    #print(desc)

def disk_replacement_check(ipintic,ticid):
    disk_id = input("Enter the Disk details: ")
    _CC.ClrPrint(f"--------------------",'BLK','BLD')
    _CC.ClrPrint(f"Running disk-replacement-safety.py --ip {ipintic} {disk_id}",'BLK','BLD')
    _CC.ClrPrint(f"--------------------",'BLK','BLD')
    disk_replacement_command = f"disk-replacement-safety.py --json --ip {ipintic} {disk_id}"
    try:
        disk_replacement_command_out = subprocess.run(disk_replacement_command, shell=True, text=True, capture_output=True)
        disk_replacement_command_stdout = disk_replacement_command_out.stdout.strip()
        # Print the raw output for debugging
        #print(f"Command Output: {disk_replacement_command_stdout}")
        
        # Extract the JSON portion of the output (starting with '{')
        json_data_start = disk_replacement_command_stdout.find('{')
        
        if json_data_start != -1:
            # Extract the JSON part and parse it
            json_data = disk_replacement_command_stdout[json_data_start:]
            try:
                data = json.loads(json_data)
                disk_details = data['disk_details']
                for disk_id, disk_info in disk_details.items():
                    print(f"Disk ID: {disk_id}")
                    print("Messages:")
                    for message in disk_info['messages']:
                        print(f"  - {message}")
                    print(f"Summary: {disk_info['summary']}")
                    print(f"OK Status: {disk_info['ok']}")
                    print("-" * 60)
            except json.JSONDecodeError as e:
                print(f"Error: The command output is not valid JSON. {e}")
                print(f"JSON Output was: {json_data}")
            if disk_info['summary'].strip() == f"Disk {disk_id} - OK".strip(): #evaluating if disk is safe to replace with O/P
                _CC.ClrPrint(f"Disk {disk_id} - OK | Safe to Replace the Disk",'GRN','BLD')
                try:
                    tic_update_command = f'update-tix -t {ticid} -a "Running Webxtool | Disk safety Replacement check | Safe to Replace {disk_id}" -d "Disk ID: {disk_id} Summary: {disk_info}"'
